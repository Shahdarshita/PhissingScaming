@using System.Linq
@model List<PhissingScaming.Models.QuizQuestion>

@{
    ViewData["Title"] = "Quiz";
    var results = ViewBag.Results as List<(PhissingScaming.Models.QuizQuestion Question, int? SelectedIndex, bool IsCorrect)>;
    int score = ViewBag.Score ?? -1;
    int total = ViewBag.Total ?? Model.Count;
    string finalMessage = ViewBag.FinalMessage ?? "";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="gradient-title mb-1">Security Knowledge Quiz</h2>
        <p class="small-muted mb-0">Test your awareness against real-world scam and phishing scenarios.</p>
    </div>
    <span class="badge badge-nextjs">@Model.Count Questions</span>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    @for (int i = 0; i < Model.Count; i++)
    {
        var q = Model[i];
        var resLocal = results != null ? results.FirstOrDefault(r => r.Question != null && r.Question.Id == q.Id) : default;
        bool hasRes = results != null && resLocal.Question != null;
        <div class="card mb-3 quiz-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary opacity-75">Q@(i + 1)</span>
                    <h5 class="mb-0 fw-semibold text-light">@q.Question</h5>
                </div>
                <div class="d-flex flex-column gap-2 mt-3">
                    @for (int j = 0; j < q.Options.Count; j++)
                    {
                        <div class="form-check p-3 rounded border border-secondary border-opacity-25 bg-dark bg-opacity-50">
                            <input class="form-check-input ms-0 me-3" type="radio"
                                   name="q_@(q.Id)"
                                   id="q_@(q.Id)_option_@(j)"
                                   value="@j" />
                            <label class="form-check-label text-light fw-medium" for="q_@(q.Id)_option_@(j)">@q.Options[j]</label>
                        </div>
                    }
                </div>

                @if (hasRes)
                {
                    <div class="mt-3 p-3 rounded bg-dark bg-opacity-75 border border-secondary border-opacity-25">
                        @if (resLocal.IsCorrect)
                        {
                            <span class="badge bg-success">Correct</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Incorrect</span>
                        }
                        <div class="mt-2 text-light"><strong>Correct answer:</strong> @q.Options[q.CorrectOptionIndex]</div>
                        <div class="text-secondary small mt-1">@q.Explanation</div>
                    </div>
                }
            </div>
        </div>
    }
    <div class="mt-4">
        <button type="submit" class="btn btn-brand btn-lg">Submit Answers</button>
    </div>
</form>

@if (score >= 0)
{
    <div class="mt-4">
        <div class="alert alert-info fade-in-up">
            <h4 class="fw-bold mb-1">Score: @score / @total</h4>
            <p class="mb-0">@finalMessage</p>
        </div>
    </div>
}
