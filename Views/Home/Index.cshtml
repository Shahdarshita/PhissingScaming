@{
    ViewData["Title"] = "Home";
}
<div class="row align-items-center g-4">
    <div class="col-lg-7">
        <div class="hero-box">
            <span class="badge badge-nextjs mb-3">🛡️ Cyber Security &amp; Fraud Prevention</span>
            <h1 class="display-6 fw-bold gradient-title-accent mb-3">Phishing, Scam &amp; Fraud Detection Platform</h1>
            <p class="lead text-secondary">Master the skills to spot phishing, smishing, vishing, and identity theft. Built as a next-generation security awareness simulation tool.</p>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <a class="btn btn-brand" href="/Home/Modules">Explore Modules</a>
                <a class="btn btn-success" href="/Quiz">Take Security Quiz</a>
                <a class="btn btn-outline-light" href="/Detector">AI Scam Detector</a>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="card-title m-0">Awareness Categories</h5>
                    <span class="badge bg-primary opacity-75">5 Core Topics</span>
                </div>
                <ul class="list-group list-group-flush category-list">
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>📧 Phishing Email Analysis</span>
                        <span class="text-muted small">High Risk</span>
                    </li>
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>💬 Smishing &amp; SMS Scams</span>
                        <span class="text-muted small">Frequent</span>
                    </li>
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>📞 Vishing &amp; Phone Fraud</span>
                        <span class="text-muted small">Urgent</span>
                    </li>
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>🪪 Identity Theft Prevention</span>
                        <span class="text-muted small">Critical</span>
                    </li>
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>💳 Financial &amp; UPI Scams</span>
                        <span class="text-muted small">Prevalent</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="mb-3 fs-3">🔍</div>
                <h5 class="card-title">Quick Verification</h5>
                <p class="card-text text-secondary">Always verify unexpected messages by contacting official channels directly using URLs from official apps.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="mb-3 fs-3">🔐</div>
                <h5 class="card-title">Zero-Trust OTP Policy</h5>
                <p class="card-text text-secondary">Never share OTPs, passwords, or PINs with anyone — legitimate institutions will never ask for them.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="mb-3 fs-3">🚨</div>
                <h5 class="card-title">Instant Reporting</h5>
                <p class="card-text text-secondary">If you suspect fraud, block card access immediately and report to National Cyber Crime Portal (1930).</p>
            </div>
        </div>
    </div>
</div>
